# Copy to .env.aws (do not commit) for production dashboard / CLI
AWS_REGION=sa-east-1
TABLE_NAME=leilao-radar-lotes
LOG_LEVEL=INFO

# Leave DYNAMODB_ENDPOINT_URL unset so boto3 uses real AWS DynamoDB
# DYNAMODB_ENDPOINT_URL=

# Use `aws configure` or export real keys / SSO profile:
# AWS_PROFILE=default
